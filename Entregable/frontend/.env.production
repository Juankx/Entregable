# API en producción: DEBE ser HTTPS para evitar "contenido mixto" en innovationbussines.com
# Configura api.innovationbussines.com en tu EC2 con Nginx + SSL (Let's Encrypt) y proxy a Node:5000
VITE_API_URL=https://api.innovationbussines.com/api

# Usar backend real en producción
VITE_OFFLINE_MODE=false

# Entorno
NODE_ENV=development
